# ============================================================
# InstaServe configuration template
# Copy to `.env` for local development.
# Secrets are marked with: [secret]
# ============================================================

# ============================================================
# App
# ============================================================
NODE_ENV=development
APP_ENV=local
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:8080
LOG_LEVEL=debug

# ============================================================
# Provider selection
# ============================================================
AUTH_PROVIDER=jwt
DATABASE_PROVIDER=postgres
CACHE_PROVIDER=redis
STORAGE_PROVIDER=s3
PAYMENT_PROVIDER=mock
NOTIFICATION_PROVIDER=default
SEARCH_PROVIDER=postgres
KYC_PROVIDER=mock
LLM_PROVIDER=mock
EVENT_PROVIDER=dynamodb

# ============================================================
# Auth
# ============================================================
AUTH_PROVIDER=firebase
JWT_SECRET=change-me-in-production # [secret]
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH= # [secret] path to service-account.json

# ============================================================
# Database
# ============================================================
DATABASE_URL=postgres://instaserve:instaserve_dev@localhost:5432/instaserve # [secret]
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ============================================================
# Cache
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false
REDIS_KEY_PREFIX=instaserve
CACHE_TTL_SECONDS=300
BOOKING_HOLD_TTL_SECONDS=300
IDEMPOTENCY_TTL_SECONDS=600

# ============================================================
# Storage / AWS
# ============================================================
AWS_PROFILE=instaserve
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

S3_BUCKET_UPLOADS=instaserve-dev-uploads-sridatta01
S3_BUCKET_VERIFICATION=instaserve-dev-verification

S3_PREFIX_LISTINGS=listings/
S3_PREFIX_CLAIMS=claims/
S3_PREFIX_CHAT=chat/
S3_PREFIX_VERIFICATION=verification/

S3_PRESIGNED_UPLOAD_EXPIRY_SECONDS=300
S3_PRESIGNED_DOWNLOAD_EXPIRY_SECONDS=300

# ============================================================
# Events / NoSQL
# ============================================================
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_AUDIT_EVENTS_TABLE=instaserve-local-audit-events
DYNAMODB_FRAUD_SIGNALS_TABLE=instaserve-local-fraud-signals
DYNAMODB_API_REQUEST_LOGS_TABLE=instaserve-local-api-request-logs
DYNAMODB_SEARCH_EVENTS_TABLE=instaserve-local-search-events
DYNAMODB_ANALYTICS_EVENTS_TABLE=instaserve-local-analytics-events
DYNAMODB_COMMUNICATION_LOGS_TABLE=instaserve-local-communication-logs
DYNAMODB_RECOMMENDATION_SIGNALS_TABLE=instaserve-local-recommendation-signals

# ============================================================
# Payments
# ============================================================
PAYMENT_DEFAULT_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET= # [secret]
RAZORPAY_WEBHOOK_SECRET= # [secret]
STRIPE_SECRET_KEY= # [secret]
STRIPE_WEBHOOK_SECRET= # [secret]

# ============================================================
# Notifications
# ============================================================
SES_FROM_EMAIL=noreply@instaserve.in
SNS_SMS_SENDER_ID=InstaServe
SQS_NOTIFICATION_QUEUE_URL=

# SMTP — when SMTP_HOST is set, transactional emails (booking confirmation,
# cancellation, etc.) route through nodemailer instead of the AWS SES SDK.
# Point at any SMTP server (SES SMTP interface, SendGrid, Postmark, …).
# Leave SMTP_HOST blank to keep the SES SDK path. SES SMTP example:
#   SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=<SES SMTP username>
#   SMTP_PASS=<SES SMTP password>      # [secret]
#   SMTP_FROM_EMAIL=noreply@istaseva.com
#   SMTP_SECURE=false                  # true for port 465 implicit TLS
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS= # [secret]
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# ============================================================
# KYC
# ============================================================
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET= # [secret]
DIGILOCKER_REDIRECT_URI=

# ============================================================
# LLM
# LLM_PROVIDER=gemini REQUIRES GEMINI_VERTEX_SA_JSON + GEMINI_VERTEX_PROJECT
# below — boot fails without them (the GEMINI_API_KEY path was removed;
# Gemini text, Live voice, and Google TTS all authenticate via ONE Vertex
# service account). Default `mock` boots with no Google credentials.
# ============================================================
LLM_PROVIDER=mock # mock | gemini | openai | anthropic
LLM_MODEL=gemini-2.5-flash
# Raw service-account key-file JSON contents (it gets JSON.parse'd).
GEMINI_VERTEX_SA_JSON= # [secret]
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=us-central1
OPENAI_API_KEY= # [secret]
ANTHROPIC_API_KEY= # [secret]

# ============================================================
# Speech (Text-to-Speech)
# Google Cloud TTS produces natural, multilingual voices including
# Hindi, Telugu, Tamil, Kannada, Malayalam, Marathi, Bengali, Gujarati.
# TTS_PROVIDER=google reuses the SAME Vertex service account as Gemini
# above (GEMINI_VERTEX_SA_JSON + GEMINI_VERTEX_PROJECT) — no separate
# API key. `none` disables voice output.
# ============================================================
TTS_PROVIDER=none # google | none
GOOGLE_TTS_VOICE_MODEL=Neural2

# ============================================================
# Image moderation (NSFW gate for listing photos)
# `npm run dev:setup` starts the microservice on port 8501 — leave this
# pointing at it, or the gate is SILENTLY OFF (uploads pass unmoderated).
# ============================================================
IMAGE_MODERATION_URL=http://localhost:8501
IMAGE_MODERATION_FAIL_CLOSED=false
IMAGE_MODERATION_TIMEOUT_MS=8000

# ============================================================
# Geocoding / Places
# ============================================================
GEOCODING_PROVIDER=google # google | nominatim
GOOGLE_MAPS_API_KEY= # [secret] loaded server-side; can come from AWS Secrets Manager

# ============================================================
# Frontend (Vite)
# ============================================================
VITE_APP_URL=http://localhost:8080
VITE_ENVIRONMENT=development
VITE_API_URL=http://localhost:3001

# Provider selection
VITE_AUTH_PROVIDER=firebase
VITE_DATABASE_PROVIDER=postgres
VITE_STORAGE_PROVIDER=s3
VITE_REALTIME_PROVIDER=websocket
VITE_PAYMENT_PROVIDER=mock
VITE_NOTIFICATION_PROVIDER=mock
VITE_SEARCH_PROVIDER=local
VITE_KYC_PROVIDER=mock
VITE_AI_PROVIDER=gemini
VITE_ANALYTICS_PROVIDER=mock

VITE_AWS_REGION=ap-south-1

# Auth / Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Realtime
VITE_WS_URL=ws://localhost:3001/ws

# Storage / Payments / Search / Analytics
VITE_S3_BUCKET=
VITE_RAZORPAY_KEY_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_MIXPANEL_TOKEN=

# Frontend AI (model name only — API key stays on backend)
VITE_AI_MODEL=gemini-2.5-flash
