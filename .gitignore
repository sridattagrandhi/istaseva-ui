# Env files — NEVER commit real env files. Copy .env.example and fill locally.
.env
.env.*
!.env.example
server/.env
server/.env.*
!server/.env.example
mobile/.env
mobile/.env.*
!mobile/.env.example

# Secrets / credentials
service-account.json
firebase-service-account*.json
*.pem
*.key
*.p12
*.pfx
google-services.json
GoogleService-Info.plist
# …except the mobile CLIENT config under mobile/firebase/: those are public
# identifiers (same values app.config.ts already commits), not secrets, and the
# native build is unreproducible without them. firebase-service-account*.json
# (the real server-side secret) stays ignored above.
!mobile/firebase/google-services.json
!mobile/firebase/**/GoogleService-Info.plist

