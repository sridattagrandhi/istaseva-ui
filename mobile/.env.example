# Mobile env — copy to `.env` and adjust for your machine. `.env` is gitignored.
#
# APP_ENV selects the variant (development | staging | production). Locally you
# normally leave this unset — the npm scripts already set APP_ENV=development.
# EAS sets it per build profile (see eas.json), so it's not needed here.

# API base URL override. The iOS Simulator can use localhost; a physical device
# or the Android emulator CANNOT reach your dev machine via localhost:
#   - Physical phone : your Mac's LAN IP, e.g. http://192.168.1.42:3001
#   - Android emulator: http://10.0.2.2:3001
# Leave unset to use the per-env default in app.config.ts (localhost:3001 in dev).
# EXPO_PUBLIC_API_URL=http://localhost:3001

# Firebase is the same project across all envs (mobile mirrors web), so these
# rarely need overriding — app.config.ts has the working defaults baked in.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
