# ============================================================
# InstaServe API Server — Environment Configuration
# ============================================================
# Copy to .env and fill in values for your environment.
# ============================================================

# ── Server ──
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:8080

# ── Database (PostgreSQL) ──
DATABASE_URL=postgres://instaserve:instaserve_dev@localhost:5432/instaserve
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Events / NoSQL ──
EVENT_PROVIDER=dynamodb
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_AUDIT_EVENTS_TABLE=instaserve-local-audit-events
DYNAMODB_FRAUD_SIGNALS_TABLE=instaserve-local-fraud-signals
DYNAMODB_API_REQUEST_LOGS_TABLE=instaserve-local-api-request-logs
DYNAMODB_SEARCH_EVENTS_TABLE=instaserve-local-search-events
DYNAMODB_ANALYTICS_EVENTS_TABLE=instaserve-local-analytics-events
DYNAMODB_COMMUNICATION_LOGS_TABLE=instaserve-local-communication-logs
DYNAMODB_RECOMMENDATION_SIGNALS_TABLE=instaserve-local-recommendation-signals

# ── AWS General ──
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Auth ──
AUTH_PROVIDER=firebase
JWT_SECRET=your-jwt-secret-for-dev
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Storage (S3) ──
S3_BUCKET_UPLOADS=instaserve-uploads
S3_BUCKET_VERIFICATION=instaserve-verification-docs
S3_BUCKET_FRONTEND=instaserve-frontend

# ── Payments (Razorpay — India-first) ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Payments (Stripe — International fallback) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Notifications ──
SES_FROM_EMAIL=noreply@instaserve.in
SNS_SMS_SENDER_ID=InstaServe
SQS_NOTIFICATION_QUEUE_URL=

# ── KYC ──
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=

# ── LLM / AI ──
# LLM_PROVIDER=gemini REQUIRES the two Vertex vars below — boot fails without
# them (the GEMINI_API_KEY path was removed; Gemini text, Live voice, and
# Google TTS all authenticate via ONE Vertex service account). Use
# LLM_PROVIDER=mock to run locally without Google credentials.
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
# Vertex service-account credentials (required when LLM_PROVIDER=gemini or
# TTS_PROVIDER=google). GEMINI_VERTEX_SA_JSON is the RAW key-file JSON
# contents (it gets JSON.parse'd) — see common/config/schemas/llm.schema.ts.
GEMINI_VERTEX_PROJECT=
GEMINI_VERTEX_LOCATION=us-central1
GEMINI_VERTEX_SA_JSON=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Assistant agent loop (see common/config/schemas/llm.schema.ts for all flags)
ASSISTANT_TOOL_LOOP=1
# User id of the staffed support account the assistant's escalate_to_human
# tool DMs. Unset = escalation stays a telemetry-only stub.
ASSISTANT_SUPPORT_USER_ID=

# ── Logging ──
LOG_LEVEL=debug

# ── Image moderation (NSFW gate for listing photos) ──
# URL of the local moderation microservice (services/image-moderation/).
# `npm run dev:setup` (repo root) starts it on port 8501 — point at it or the
# gate is SILENTLY OFF (uploads pass through unmoderated).
IMAGE_MODERATION_URL=http://localhost:8501
# true = reject uploads when the moderation service is unreachable.
# Default (false) fails open so an outage never blocks legitimate uploads.
IMAGE_MODERATION_FAIL_CLOSED=false
IMAGE_MODERATION_TIMEOUT_MS=8000
